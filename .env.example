# Copy to .env.local for local development. Never commit real values.

# Supabase project (Dashboard > Project Settings > API). Local: values from `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Canonical URL used in OAuth redirects and invite links. Optional; falls back to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/keepalive. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Only for `npm test` DB tests against LOCAL Supabase (see README).
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_PUBLISHABLE_KEY=
# SUPABASE_TEST_SECRET_KEY=
